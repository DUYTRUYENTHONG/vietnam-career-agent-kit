{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-import recorded lead identity hints 1.0 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "leads"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "leads": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "platform", "platform_job_id", "employer", "req_id", "title", "city", "url"],
        "properties": {
          "id": {"type": "string", "maxLength": 500, "pattern": "\\S"},
          "platform": {"type": "string", "maxLength": 500},
          "platform_job_id": {"type": "string", "maxLength": 500},
          "employer": {"type": "string", "maxLength": 500},
          "req_id": {"type": "string", "maxLength": 500},
          "title": {"type": "string", "maxLength": 500},
          "city": {"type": "string", "maxLength": 500},
          "url": {"type": "string", "maxLength": 2048, "pattern": "^https://", "format": "uri"}
        }
      }
    }
  }
}
