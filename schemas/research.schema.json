{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public research contracts 1.0; runtime validators are authoritative",
  "$ref": "#/$defs/ResearchPlan",
  "$defs": {
    "ResearchPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "provider_account",
        "expires_utc",
        "roles",
        "locations",
        "sources",
        "urls",
        "limits",
        "freshness"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "plan_id": {
          "type": "string"
        },
        "provider_account": {
          "type": "string"
        },
        "expires_utc": {
          "type": "string",
          "format": "date-time"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "host",
              "permission_reference",
              "expires_utc",
              "public_read_allowed"
            ],
            "properties": {
              "source_id": {
                "enum": [
                  "employer-careers",
                  "public-feed",
                  "university-alumni",
                  "greenhouse-public-board"
                ]
              },
              "host": {
                "type": "string"
              },
              "permission_reference": {
                "type": "string"
              },
              "expires_utc": {
                "type": "string",
                "format": "date-time"
              },
              "public_read_allowed": {
                "const": true
              }
            }
          }
        },
        "urls": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "pages",
            "workers",
            "domain_workers",
            "runtime_seconds",
            "credit_reservation"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "domain_workers": {
              "const": 1
            },
            "runtime_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "credit_reservation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "search_seconds",
            "page_seconds",
            "provider_max_age_ms"
          ],
          "properties": {
            "search_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "page_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600
            },
            "provider_max_age_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600000
            }
          }
        }
      }
    },
    "ProviderCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "search",
        "scrape",
        "batch_extraction",
        "goal_interaction",
        "browser_sessions",
        "persistent_profiles",
        "uploads",
        "screenshots",
        "cancellation",
        "idempotency",
        "schema_version"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "search": {
          "type": "boolean"
        },
        "scrape": {
          "type": "boolean"
        },
        "batch_extraction": {
          "type": "boolean"
        },
        "goal_interaction": {
          "type": "boolean"
        },
        "browser_sessions": {
          "type": "boolean"
        },
        "persistent_profiles": {
          "type": "boolean"
        },
        "uploads": {
          "type": "boolean"
        },
        "screenshots": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "idempotency": {
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "DiscoveryHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "snippet",
        "source_id",
        "schema_version"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "PageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_url",
        "final_url",
        "source_id",
        "provider",
        "retrieved_utc",
        "content_sha256",
        "markdown",
        "normalized_fields",
        "missing_fields",
        "extraction_status",
        "liveness",
        "provider_cache_timestamp",
        "source_timestamp",
        "parser_version",
        "schema_version"
      ],
      "properties": {
        "original_url": {
          "type": "string"
        },
        "final_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "retrieved_utc": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "normalized_fields": {
          "type": "object"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraction_status": {
          "type": "string"
        },
        "liveness": {
          "type": "string"
        },
        "provider_cache_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "parser_version": {
          "type": "string"
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ProviderTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "operation",
        "state",
        "remote_id",
        "schema_version"
      ],
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "remote_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ProviderUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credits",
        "tokens",
        "billed_cost",
        "provider_seconds",
        "schema_version"
      ],
      "properties": {
        "credits": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokens": {
          "type": [
            "number",
            "null"
          ]
        },
        "billed_cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "provider_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ProviderError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "code",
        "possibly_accepted",
        "retry_after"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "code": {
          "type": "string"
        },
        "possibly_accepted": {
          "type": "boolean"
        },
        "retry_after": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
