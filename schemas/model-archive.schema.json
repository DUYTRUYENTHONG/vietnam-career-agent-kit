{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local downloaded adapter byte verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_utc",
    "archive",
    "adapter",
    "verification_scope",
    "training_status",
    "quality_status",
    "archive_extracted",
    "promotion_performed",
    "provider_calls",
    "ledger_opened"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verified_utc": {
      "type": "string",
      "format": "date-time"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "members"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "bytes",
        "sha256",
        "declared_base"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "declared_base": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification_scope": {
      "const": "archive_and_selected_adapter_bytes_only"
    },
    "training_status": {
      "const": "not_assessed"
    },
    "quality_status": {
      "const": "not_assessed"
    },
    "archive_extracted": {
      "const": false
    },
    "promotion_performed": {
      "const": false
    },
    "provider_calls": {
      "const": 0
    },
    "ledger_opened": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
