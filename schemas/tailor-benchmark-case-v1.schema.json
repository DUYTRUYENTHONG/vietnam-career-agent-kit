{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound tailoring benchmark case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "profile_group", "source_group", "language", "requirement", "facts", "exposure"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "profile_group": {"type": "string", "minLength": 1},
    "source_group": {"type": "string", "minLength": 1},
    "language": {"enum": ["en", "vi"]},
    "exposure": {"type": "string", "minLength": 1},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "source"],
      "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/source"}}
    },
    "facts": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "scope", "qualifiers", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "qualifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source": {"$ref": "#/$defs/source"}
      }
    }}
  },
  "$defs": {"source": {
    "type": "object", "additionalProperties": false, "required": ["path", "sha256", "locator"],
    "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "locator": {"type": "string", "minLength": 1}}
  }}
}
