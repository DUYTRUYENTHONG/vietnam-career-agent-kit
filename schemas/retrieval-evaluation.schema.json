{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private retrieval gold queries v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "limit", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 10},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "query", "expected_fact_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "query": {"type": "string", "minLength": 1, "maxLength": 1000},
          "expected_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  },
  "$comment": "Runtime also checks unique/nonblank IDs, query words, current confirmed fact IDs and source hashes. Empty expected IDs label a negative query."
}
