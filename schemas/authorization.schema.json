{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standing campaign authorization input 1.0",
  "description": "Opt-in finite delegation. Runtime additionally validates confirmed profile/actor binding, exact recipient and safe path/query prefix, source-backed reviews, Strong/Plausible fit, shared irrevocable allocations, UTC expiry and exact local proof format. Human provenance and host permissions remain external. This input is not an approval.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expires_utc": {
      "type": "string",
      "format": "date-time"
    },
    "submission_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "bridge_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 128
    },
    "runtime_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "employer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "destination_prefix": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "operations": {
            "type": "array",
            "items": {
              "enum": [
                "fill",
                "upload",
                "submit"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "contains": {
              "const": "submit"
            }
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "source": {
                  "enum": [
                    "profile_fact",
                    "candidate_confirmed"
                  ]
                },
                "fact_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "uniqueItems": true
                },
                "kind": {
                  "const": "ordinary"
                }
              },
              "required": [
                "value",
                "source",
                "fact_ids",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "consents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "choice": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "text",
                "choice"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "employer",
          "destination_prefix",
          "operations",
          "answers",
          "consents"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "authorization_id",
    "expires_utc",
    "submission_limit",
    "bridge_id",
    "runtime_minutes",
    "targets"
  ],
  "additionalProperties": false
}
