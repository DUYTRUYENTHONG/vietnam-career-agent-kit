{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captured requirement corpus inputs (private)",
  "oneOf": [{"$ref": "#/$defs/snapshot"}, {"$ref": "#/$defs/extractions"}],
  "$defs": {
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "quote", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "kind": {"enum": ["required", "preferred", "unknown"]}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "employer", "job_key", "source_url", "raw_text", "source_kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "employer": {"type": "string", "minLength": 1},
        "job_key": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "raw_text": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["full_jd", "excerpt", "assessment_summary", "unknown"]},
        "captured_utc": {"type": ["string", "null"], "format": "date-time"},
        "source_updated_utc": {"type": ["string", "null"], "format": "date-time"},
        "requirements": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/requirement"}}
      }
    },
    "extractions": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "records"],
      "properties": {
        "schema_version": {"const": "requirements-extractions-v1"},
        "records": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "raw_text_sha256", "requirements"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "raw_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "requirements": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/requirement"}}
            }
          }
        }
      }
    }
  }
}
