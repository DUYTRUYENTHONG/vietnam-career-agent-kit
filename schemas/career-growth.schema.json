{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career evidence gaps and future development plans 1.0",
  "description": "Select plan or review from $defs. Runtime also checks current profile/JD/assessment bindings, exact gap IDs, clarification routes and evidence boundaries. JSON validity does not prove skills or semantic truth.",
  "$defs": {
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "url", "source_note"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_note": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "gap_id", "kind", "objective", "steps", "acceptance_checks", "resources"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "gap_id": {"type": "string", "pattern": "^G[0-9a-f]{20}$"},
        "kind": {"enum": ["clarify", "learn", "practice", "build"]},
        "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
        "steps": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
        "acceptance_checks": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
        "resources": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/resource"}}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "job_ids", "context_fingerprint", "author", "actions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "job_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "author": {"type": "string", "minLength": 1, "maxLength": 200},
        "actions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "grounded", "feasible", "future_only", "no_cv_promotion", "reason"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "grounded": {"const": true}, "feasible": {"const": true},
        "future_only": {"const": true}, "no_cv_promotion": {"const": true},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plan_fingerprint", "reviewer", "independent", "decision", "findings"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
        "independent": {"const": true}, "decision": {"const": "approved"},
        "findings": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/finding"}}
      }
    }
  }
}
